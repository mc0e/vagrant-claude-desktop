#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  project-merge-update

Reviews and selectively merges a staged changeset into the working tree.

Finds the staging area at ~/.claude-staging/<repo-name>/, opens Meld for
side-by-side review, then optionally copies the result into the project.

Directory layout:
  ~/.claude-staging/<repo-name>/
    .manifest.json
    proposed/    new file versions written by the MCP server
    current/     copy of project files for Meld comparison (populated on
                 first run, then updated from itself after each merge)

Workflow:
  1. Run project-merge-update
  2. Review and selectively merge changes in Meld
     (left = current project files, right = proposed changes)
  3. Close Meld
  4. Optionally copy merged files from current/ into the project and commit
  5. Re-run to resume an in-progress merge session — current/ reflects
     whatever was last copied into the project, so Meld always shows
     the true baseline on the left

Options:
  -h, --help    Show this help text

Requirements:
  - git
  - meld
EOF
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
    usage
    exit 0
fi

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "Error: not inside a git repository"
    exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

REPO_NAME=$(basename "$REPO_ROOT")
STAGING_ROOT="$HOME/.claude-staging/$REPO_NAME"
MANIFEST="$STAGING_ROOT/.manifest.json"
PROPOSED_ROOT="$STAGING_ROOT/proposed"
CURRENT_ROOT="$STAGING_ROOT/current"

if [[ ! -d "$STAGING_ROOT" ]]; then
    echo "Error: no staging area found at $STAGING_ROOT"
    exit 1
fi

if [[ ! -f "$MANIFEST" ]]; then
    echo "Error: no manifest found in $STAGING_ROOT"
    exit 1
fi

if [[ ! -d "$PROPOSED_ROOT" ]]; then
    echo "Error: no proposed directory found at $PROPOSED_ROOT"
    exit 1
fi

# Read manifest fields
STATUS=$(python3 -c "import json,sys; m=json.load(open('$MANIFEST')); print(m.get('status',''))")
DESCRIPTION=$(python3 -c "import json,sys; m=json.load(open('$MANIFEST')); print(m.get('description',''))")
FILE_COUNT=$(python3 -c "import json,sys; m=json.load(open('$MANIFEST')); print(len(m.get('files',[])))")
STARTED=$(python3 -c "import json,sys; m=json.load(open('$MANIFEST')); print(m.get('started',''))")

echo "Changeset:  $DESCRIPTION"
echo "Started:    $STARTED"
echo "Files:      $FILE_COUNT"
echo "Status:     $STATUS"

if [[ "$STATUS" != "complete" ]]; then
    echo
    echo "Warning: changeset status is '$STATUS', not 'complete'."
    read -rp "Continue anyway? [y/N] " CONTINUE
    if [[ ! "$CONTINUE" =~ ^[Yy]$ ]]; then
        exit 0
    fi
fi

echo

# Check whether current/ already has content (resuming a previous session)
CURRENT_HAS_CONTENT=false
if [[ -d "$CURRENT_ROOT" ]] && [[ -n "$(ls -A "$CURRENT_ROOT" 2>/dev/null)" ]]; then
    CURRENT_HAS_CONTENT=true
fi

if $CURRENT_HAS_CONTENT; then
    echo "Resuming existing merge session (current/ already populated)."
    echo "To start fresh, delete $CURRENT_ROOT and re-run."
    echo
else
    echo "Populating current/ from project tree..."
    mkdir -p "$CURRENT_ROOT"

    python3 -c "
import json, sys
m = json.load(open('$MANIFEST'))
for f in m.get('files', []):
    print(f['path'])
" | while read -r FILE; do
        mkdir -p "$CURRENT_ROOT/$(dirname "$FILE")"
        if [[ -f "$REPO_ROOT/$FILE" ]]; then
            cp -a "$REPO_ROOT/$FILE" "$CURRENT_ROOT/$FILE"
        else
            touch "$CURRENT_ROOT/$FILE"
        fi
    done

    echo "Done."
    echo
fi

echo "Launching Meld..."
echo "(Left: current project files  |  Right: proposed changes)"
echo

if ! meld "$CURRENT_ROOT" "$PROPOSED_ROOT"; then
    MELD_STATUS=$?
    echo
    echo "Meld exited with error status $MELD_STATUS"
    echo "Aborting without copying"
    exit $MELD_STATUS
fi

echo
read -rp "Copy merged files from current/ into project? [y/N] " DOCOPY

if [[ ! "$DOCOPY" =~ ^[Yy]$ ]]; then
    echo "No files copied. Run again to reopen Meld."
    exit 0
fi

# Copy from current/ into the project tree, skipping empty files.
# Empty files in current/ mean the change was not adopted in Meld.
python3 -c "
import json, sys
m = json.load(open('$MANIFEST'))
for f in m.get('files', []):
    print(f['path'])
" | while read -r FILE; do
    if [[ ! -s "$CURRENT_ROOT/$FILE" ]]; then
        echo "  skipped (empty): $FILE"
        continue
    fi
    mkdir -p "$REPO_ROOT/$(dirname "$FILE")"
    cp -a "$CURRENT_ROOT/$FILE" "$REPO_ROOT/$FILE"
    echo "  copied: $FILE"
done

echo
read -rp "Create git commit now? [y/N] " DOCOMMIT

if [[ ! "$DOCOMMIT" =~ ^[Yy]$ ]]; then
    echo "Files copied but not committed"
    exit 0
fi

read -rp "Commit message [$DESCRIPTION]: " COMMIT_MSG
if [[ -z "$COMMIT_MSG" ]]; then
    COMMIT_MSG="$DESCRIPTION"
fi

if [[ -z "$COMMIT_MSG" ]]; then
    echo "Empty commit message; aborting commit"
    exit 1
fi

git status --short

echo
read -rp "Proceed with commit? [y/N] " REALLY

if [[ ! "$REALLY" =~ ^[Yy]$ ]]; then
    echo "Commit cancelled"
    exit 0
fi

git add -A
git commit -m "$COMMIT_MSG"

echo
echo "Done"
